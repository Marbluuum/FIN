generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  company   String?
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

model Payment {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String    @default("USD")
  status      String    @default("pendiente")
  category    String    @default("ventas_nuevas")
  paidAt      DateTime?
  dueDate     DateTime
  description String?
  stripeId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  currency    String   @default("USD")
  category    String?
  description String
  date        DateTime
  source      String   @default("manual")
  externalId  String?
  createdAt   DateTime @default(now())
}

model PersonalExpense {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  currency    String   @default("USD")
  category    String?
  description String
  date        DateTime
  createdAt   DateTime @default(now())
}

model IntegrationConfig {
  id        String  @id @default(cuid())
  provider  String  @unique
  apiKey    String
  apiSecret String?
  enabled   Boolean @default(false)
  metadata  String?
}
